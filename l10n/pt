<!DOCTYPE html>

<html lang="pt">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GronnFalk Settings</title>

    <link rel="icon" type="image/png" href="favicon3.png">

    <script src="theme.js"></script>
    <link rel="stylesheet" href="theme.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        .settings-page {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
            padding: 35px 25px 60px;
        }

        .logo-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 45px;
        }

        .logo {
            width: 210px;
            height: auto;
            display: block;
        }

        .settings-title {
            margin: 0 0 30px;
            text-align: center;
            font-size: 28px;
        }

        .settings-section {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 22px;
            margin-bottom: 20px;
            background: var(--surface);
        }

        .settings-section h2 {
            margin: 0 0 8px;
            font-size: 20px;
        }

        .settings-section p {
            margin: 0 0 18px;
            color: var(--text-muted);
            line-height: 1.5;
            font-size: 14px;
        }

       /* Settings options */

        .setting-options {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .setting-option {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--surface);
            color: var(--text);

            display: flex;
            align-items: center;
            justify-content: space-between;

            font-family: inherit;
            font-size: 15px;
            font-weight: bold;
        }

        .setting-option:hover {
            border-color: var(--accent);
        }

        /* Theme picker (radio group) */

        fieldset.theme-options {
            margin: 0;
            padding: 0;
            border: 0;
            min-width: 0;
        }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: -1px;
            padding: 0;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
            border: 0;
        }

        .theme-option {
            cursor: pointer;
        }

        .theme-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .theme-option .theme-hint {
            font-size: 13px;
            font-weight: normal;
            color: var(--text-muted);
        }

        .theme-option .theme-check {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            border: 2px solid var(--border-strong);
            border-radius: 50%;
        }

        .theme-option:has(input:checked) {
            border-color: var(--accent);
            background: var(--surface-hover);
        }

        .theme-option:has(input:checked) .theme-check {
            border-color: var(--accent);
            background: radial-gradient(
                var(--accent) 0 45%,
                transparent 50%
            );
        }

        .theme-option:has(input:focus-visible) {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        /* Toggle */

        .toggle {
            position: relative;
            width: 46px;
            height: 25px;
            flex-shrink: 0;
        }

        .toggle input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-slider {
            position: absolute;
            inset: 0;
            background: var(--toggle-off);
            border-radius: 25px;
            cursor: pointer;
            transition: 0.2s;
        }

        .toggle-slider::before {
            content: "";

            position: absolute;

            width: 19px;
            height: 19px;

            left: 3px;
            top: 3px;

            background: var(--toggle-knob);
            border-radius: 50%;

            transition: 0.2s;
        }

        .toggle input:checked + .toggle-slider {
            background: var(--accent);
        }

        .toggle input:checked + .toggle-slider::before {
            transform: translateX(21px);
        }

        .toggle input:focus-visible + .toggle-slider {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        /* Back button */

        .back-button {
            display: inline-block;

            margin-top: 10px;

            padding: 11px 18px;

            border-radius: 8px;

            background: var(--accent);
            color: var(--on-accent);

            text-decoration: none;

            font-size: 14px;
            font-weight: bold;
        }

        .back-button:hover {
            opacity: 0.9;
        }

        @media (max-width: 700px) {

            .settings-page {
                padding: 25px 15px 45px;
            }

            .logo {
                width: 175px;
            }

            .settings-title {
                font-size: 24px;
            }

        }

    </style>

</head>


<body>

<main class="settings-page">


    <div class="logo-container">

        <img
            src="gronnfalk1.png"
            alt="GronnFalk"
            class="logo"
        >

    </div>


    <h1 class="settings-title">
        Settings
    </h1>


    <!-- SEARCH ENGINES -->

    <section class="settings-section">

        <h2>
            Search Engines
        </h2>

        <p>
            Choose which search engines GronnFalk uses for search results.
        </p>


        <div class="setting-options">


            <div class="setting-option">

                <span>
                    SearXNG
                </span>

                <label class="toggle">

                    <input
                        type="checkbox"
                        class="engine-toggle"
                        data-engine="searxng"
                    >

                    <span class="toggle-slider"></span>

                </label>

            </div>


            <div class="setting-option">

                <span>
                    Google
                </span>

                <label class="toggle">

                    <input
                        type="checkbox"
                        class="engine-toggle"
                        data-engine="google"
                    >

                    <span class="toggle-slider"></span>

                </label>

            </div>


            <div class="setting-option">

                <span>
                    DuckDuckGo
                </span>

                <label class="toggle">

                    <input
                        type="checkbox"
                        class="engine-toggle"
                        data-engine="duckduckgo"
                    >

                    <span class="toggle-slider"></span>

                </label>

            </div>


            <div class="setting-option">

                <span>
                    Brave
                </span>

                <label class="toggle">

                    <input
                        type="checkbox"
                        class="engine-toggle"
                        data-engine="brave"
                    >

                    <span class="toggle-slider"></span>

                </label>

            </div>


            <div class="setting-option">

                <span>
                    4get
                </span>

                <label class="toggle">

                    <input
                        type="checkbox"
                        class="engine-toggle"
                        data-engine="4get"
                    >

                    <span class="toggle-slider"></span>

                </label>

            </div>


        </div>

    </section>

    <!-- THEME -->

    <section class="settings-section">

        <h2>
            Theme
        </h2>

        <p>
            Choose how GronnFalk looks. "System" follows your device setting.
        </p>

        <fieldset class="theme-options setting-options">

            <legend class="visually-hidden">Theme</legend>

            <label class="setting-option theme-option">
                <span>
                    System
                    <span class="theme-hint">&middot; match device</span>
                </span>
                <input type="radio" name="theme" value="system">
                <span class="theme-check" aria-hidden="true"></span>
            </label>

            <label class="setting-option theme-option">
                <span>Light</span>
                <input type="radio" name="theme" value="light">
                <span class="theme-check" aria-hidden="true"></span>
            </label>

            <label class="setting-option theme-option">
                <span>Dark</span>
                <input type="radio" name="theme" value="dark">
                <span class="theme-check" aria-hidden="true"></span>
            </label>

        </fieldset>

    </section>


    <a
        href="index.html"
        class="back-button"
    >
        Back to GronnFalk
    </a>


</main>


<script>


    /* =========================
       LANGUAGE SETTINGS
       ========================= */

    const languageOptions =
        document.querySelectorAll(".language-option");


    function updateActiveLanguage() {

        const savedLanguage =
            localStorage.getItem("gronnfalk-language") || "en";


        languageOptions.forEach(function(option) {

            if (
                option.dataset.language ===
                savedLanguage
            ) {

                option.classList.add("active");

            } else {

                option.classList.remove("active");

            }

        });

    }


    languageOptions.forEach(function(option) {

        option.addEventListener("click", function() {

            const language =
                option.dataset.language;


            localStorage.setItem(
                "gronnfalk-language",
                language
            );


            updateActiveLanguage();

        });

    });


    /* =========================
       SEARCH ENGINE SETTINGS
       ========================= */

    const engineToggles =
        document.querySelectorAll(".engine-toggle");


    const defaultEngineSettings = {

        searxng: true,

        google: true,

        duckduckgo: true,

        brave: true,

        "4get": true

    };


    function getEngineSettings() {

        const saved =
            localStorage.getItem(
                "gronnfalk-search-engines"
            );


        if (!saved) {

            return {
                ...defaultEngineSettings
            };

        }


        try {

            const parsed =
                JSON.parse(saved);


            return {
                ...defaultEngineSettings,
                ...parsed
            };

        } catch (error) {

            return {
                ...defaultEngineSettings
            };

        }

    }


    function loadEngineSettings() {

        const engines =
            getEngineSettings();


        engineToggles.forEach(function(toggle) {

            const engine =
                toggle.dataset.engine;


            toggle.checked =
                engines[engine] === true;

        });

    }


    function saveEngineSettings() {

        const engines = {};


        engineToggles.forEach(function(toggle) {

            engines[
                toggle.dataset.engine
            ] = toggle.checked;

        });


        localStorage.setItem(

            "gronnfalk-search-engines",

            JSON.stringify(engines)

        );

    }


    engineToggles.forEach(function(toggle) {

        toggle.addEventListener(
            "change",
            saveEngineSettings
        );

    });

    /* =========================
       THEME SETTINGS
       ========================= */

    const themeRadios =
        document.querySelectorAll('input[name="theme"]');


    themeRadios.forEach(function(radio) {

        radio.checked =
            radio.value === window.GronnFalkTheme.get();

        radio.addEventListener("change", function() {

            window.GronnFalkTheme.set(radio.value);

        });

    });

    // Keep the picker in sync if the theme is changed in another tab.
    window.addEventListener("storage", function() {

        themeRadios.forEach(function(radio) {

            radio.checked =
                radio.value === window.GronnFalkTheme.get();

        });

    });



    /* =========================
       START SETTINGS
       ========================= */

    updateActiveLanguage();
    loadEngineSettings();

</script>


</body>

</html>

